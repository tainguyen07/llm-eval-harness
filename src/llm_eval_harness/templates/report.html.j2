<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Run {{ report.name }} — {{ report.run_id[:8] }}</title>
<style>
  :root { color-scheme: light dark; --fg:#1a1a1a; --bg:#fdfdfd; --muted:#666; --accent:#3858dc; --ok:#198754; --warn:#b88500; --bad:#c0392b; }
  @media (prefers-color-scheme: dark) { :root { --fg:#eaeaea; --bg:#0f0f10; --muted:#9b9b9b; --accent:#7c9cff; --ok:#2ecc71; --warn:#e1b94d; --bad:#ff6b6b; } }
  html, body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; background: var(--bg); color: var(--fg); margin: 0; padding: 0; }
  main { max-width: 960px; margin: 2rem auto; padding: 0 1.5rem; }
  header h1 { margin-bottom: 0.2rem; }
  header .meta { color: var(--muted); font-size: 0.9rem; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .card { padding: 1rem 1.25rem; border-radius: 12px; background: color-mix(in srgb, var(--bg) 92%, var(--accent) 8%); border: 1px solid color-mix(in srgb, var(--fg) 8%, transparent); }
  .card .label { font-size: 0.78rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .card .value { font-size: 1.6rem; font-weight: 600; margin-top: 0.25rem; }
  table { width: 100%; border-collapse: collapse; margin-top: 1.5rem; }
  th, td { padding: 0.55rem 0.75rem; border-bottom: 1px solid color-mix(in srgb, var(--fg) 10%, transparent); text-align: left; }
  th { font-weight: 600; color: var(--muted); font-size: 0.85rem; }
  td.pass { color: var(--ok); }
  td.fail { color: var(--bad); }
  pre { background: color-mix(in srgb, var(--fg) 4%, transparent); padding: 0.75rem; border-radius: 8px; overflow-x: auto; font-size: 0.85rem; }
  details summary { cursor: pointer; padding: 0.5rem 0; }
  .footer { margin-top: 3rem; color: var(--muted); font-size: 0.85rem; }
</style>
</head>
<body>
<main>
  <header>
    <h1>Run <code>{{ report.name }}</code></h1>
    <div class="meta">
      <span>id: <code>{{ report.run_id }}</code></span> ·
      <span>{{ report.dataset_size }} examples</span> ·
      <span>concurrency {{ report.concurrency }}</span>
    </div>
  </header>

  <section class="cards">
    {% for name, stats in scores.items() %}
      <div class="card">
        <div class="label">{{ name }} mean</div>
        <div class="value">{{ "%.3f"|format(stats.mean) }}</div>
        <div class="meta">{{ stats.passes }} / {{ stats.n }} pass</div>
      </div>
    {% endfor %}
  </section>

  <h2>Summary</h2>
  <pre>{{ summary }}</pre>

  {% if data_json %}
    <details>
      <summary>Raw report JSON</summary>
      <pre id="report-data">{{ data_json }}</pre>
    </details>
  {% endif %}

  <div class="footer">Generated by llm-eval-harness.</div>
</main>
</body>
</html>